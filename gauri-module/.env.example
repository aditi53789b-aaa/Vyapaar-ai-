# ---------- Next.js (frontend) ----------
OPENAI_API_KEY=            # chat (gpt-4o-mini), Whisper, and embeddings for pgvector
DATABASE_URL=postgres://user:pass@localhost:5432/vyapaar
# Optional: use Llama 3.3 for chat instead of GPT-4o-mini (embeddings still use OpenAI)
# LLM_PROVIDER=llama
# LLM_API_KEY=             # e.g. a Groq key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

SPEECH_SERVICE_URL=http://localhost:8000
SPEECH_API_KEY=change-me                 # same value on both sides
SPEECH_WS_SECRET=change-me-too           # same value on both sides (signs live-stream tokens)
NEXT_PUBLIC_SPEECH_WS_URL=ws://localhost:8000/speech/stream

# ---------- FastAPI (backend) ----------
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
SPEECH_WEBHOOK_SECRET=change-me-three    # signs webhooks in and out
WEBHOOK_ALLOWED_HOSTS=api.example.com    # hosts that async jobs may call back
ALLOWED_ORIGINS=http://localhost:3000    # browser origins allowed on the WebSocket
# SPEECH_ENV=dev                         # LOCAL ONLY: skips key/token checks
